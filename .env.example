# ProEthica Development Environment Variables
# Copy this file to .env and fill in your API keys.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-change-in-production
ENVIRONMENT=development

# Database
SQLALCHEMY_DATABASE_URI=postgresql://postgres:PASS@localhost:5432/ai_ethical_dm

# LLM API Keys (at minimum, set ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=<your-anthropic-api-key>
OPENAI_API_KEY=<your-openai-api-key>
# GOOGLE_API_KEY=<your-google-api-key>
# GOOGLE_GEMINI_API_KEY=<your-gemini-api-key>

# Model Selection
CLAUDE_DEFAULT_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_POWERFUL_MODEL=claude-fable-5-1
CLAUDE_GATE_MODEL=claude-opus-5-5
# Provider-qualified tier references (optional; overrides the CLAUDE_* tier
# above for the named tier). Format: provider:model. Unset preserves
# Anthropic behavior. Repointing a tier changes extraction calibration:
# run scripts/llm_provider_smoke.py first and see
# docs-internal/llm-provider/BRANCH_NOTES.md before changing gate.
# LLM_DEFAULT_REF=openai:gpt-4o
# LLM_FAST_REF=openai:gpt-4o-mini
# LLM_POWERFUL_REF=anthropic:claude-fable-5-1
# LLM_GATE_REF=anthropic:claude-opus-5-5

# Embeddings
EMBEDDING_PROVIDER_PRIORITY=local,openai,anthropic,google
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# OntServe Integration (start OntServe MCP before ProEthica)
ONTSERVE_WEB_URL=http://localhost:5003
ONTSERVE_MCP_URL=http://localhost:8082
EXTERNAL_MCP_URL=http://localhost:8082
ONTSERVE_TIMEOUT=30

# Commit matching: the matcher confidence at or above which an extracted
# class is linked to an existing OntServe class instead of being minted.
# Default: the matcher auto-link band minimum (0.85). See
# app/services/commit/match_policy.py.
# PROETHICA_MATCH_LINK_THRESHOLD=0.85

# Feature Flags
USE_DRAFT_ONTOLOGIES=true
ENABLE_MCP_ONTOLOGY_ACCESS=true
ENABLE_EXTERNAL_MCP_ACCESS=true
ENABLE_ONTOLOGY_DRIVEN_LANGEXTRACT=true
PROVENANCE_ENVIRONMENT=development

# Monitoring (optional)
# ALERT_EMAIL_ENABLED=false
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=

# Validation study: Prolific completion-code redemption (validation pivot).
# Fixed code registered in the Prolific study config. When set, the /complete
# page shows a "Return to Prolific" button that redirects to
# https://app.prolific.com/submissions/complete?cc=<this value>.
# When unset, the per-session completion_code is shown for manual paste only.
# Populate once the Prolific researcher account and study exist.
# PROLIFIC_COMPLETION_CODE_SUCCESS=

# Validation study: time-on-task floor (plan validation-study.md §4.5).
# Server-side check on case-evaluation submit. If the sum of
# time_facts_review + time_views_review + time_comprehension is below this
# many seconds, the evaluation row is tagged with low_effort_flag = True for
# analyst review. Per Prolific policy, low-effort rows are NOT auto-rejected.
# Default 180s is a placeholder; recalibrate to the 10th percentile of
# completion times observed in the unpaid internal pilot (week 2). Tune
# without redeploy by setting this env var on the running service.
# STUDY_TIME_FLOOR_SECONDS=180
